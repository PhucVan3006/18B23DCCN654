<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>RestMan - De 18 - B23DCCN654</display-name>

  <welcome-file-list>
    <welcome-file>gdQuanLiMonAn4.jsp</welcome-file>
  </welcome-file-list>

  <!-- Trang doThemMonAn4.jsp nhan form multipart (co tep anh) nen phai khai bao
       multipart-config, neu khong request.getPart() se nem IllegalStateException -->
  <servlet>
    <servlet-name>doThemMonAn4</servlet-name>
    <jsp-file>/doThemMonAn4.jsp</jsp-file>
    <multipart-config>
      <max-file-size>5242880</max-file-size>
      <max-request-size>10485760</max-request-size>
      <file-size-threshold>262144</file-size-threshold>
    </multipart-config>
  </servlet>
  <servlet-mapping>
    <servlet-name>doThemMonAn4</servlet-name>
    <url-pattern>/doThemMonAn4.jsp</url-pattern>
  </servlet-mapping>

</web-app>
